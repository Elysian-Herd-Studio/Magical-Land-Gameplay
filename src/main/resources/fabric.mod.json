{
  "schemaVersion": 1,
  "id": "magicaland_gameplay",
  "version": "${version}",
  "name": "Magical Land: Gameplay",
  "description": "A Magical Land gameplay addon centered on unicorn, pegasus and earth-pony abilities and an achievement system. In active development.",
  "authors": ["JessDaodao", "MayHooves"],
  "contact": {
    "issues": "https://github.com/Magical-Land-Official/Magical-Land-Gameplay/issues",
    "sources": "https://github.com/Magical-Land-Official/Magical-Land-Gameplay"
  },
  "license": "MIT",
  "icon": "assets/magicaland_gameplay/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["top.csituka.magicaland.gameplay.MagicalLandGameplay"],
    "client": ["top.csituka.magicaland.gameplay.client.RemoteToolClient"],
    "modmenu": ["top.csituka.magicaland.gameplay.client.ModMenuIntegration"]
  },
  "mixins": ["magicaland.gameplay.mixins.json", {"config": "magicaland.gameplay.client.mixins.json", "environment": "client"}],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "magicaland": "${appearance_compatibility}"
  }
}
